[maxscale]
threads=auto
admin_host=0.0.0.0
admin_port=8989
admin_gui=true
admin_secure_gui=false


#[maxscale_pri]
#type=server
#address=172.17.0.8
#port=4000
#protocol=MariaDBBackend
#initial_status=write

[server1]
type=server
address=172.17.0.2
port=3306
protocol=MariaDBBackend

[server2]
type=server
address=172.17.0.3
port=3306
protocol=MariaDBBackend

[server3]
type=server
address=172.17.0.4
port=3306
protocol=MariaDBBackend

[server4]
type=server
address=172.17.0.5
port=3306
protocol=MariaDBBackend

[server5]
type=server
address=172.17.0.6
port=3306
protocol=MariaDBBackend

[server6]
type=server
address=172.17.0.7
port=3306
protocol=MariaDBBackend

[DC-principal-monitor]
type=monitor
module=mariadbmon
servers=server1,server2,server3,server4,server5,server6
user=root
password=MyPassw0rd#
monitor_interval=200ms
auto_failover=true
auto_rejoin=true
backend_timeout=1s
backend_read_timeout=1s
cooperative_monitoring_locks=majority_of_all
servers_no_promotion=server4,server5,server6

[DC-principal-RWS]
type=service
router=readwritesplit
#cluster=DC-principal-monitor
servers=server1,server2,server3, server4, server5,server6
user=root
password=MyPassw0rd#
transaction_replay                   = true
transaction_replay_max_size          = 100Mi
transaction_replay_attempts          = 100
transaction_replay_retry_on_deadlock = true
enable_root_user                     = true
master_reconnection                  = true
master_failure_mode                  = fail_on_write
slave_selection_criteria             = ADAPTIVE_ROUTING  
#That'll prefer local nodes for reads ; #It measures against execution time average as well as network ping so that should end with more reads locally 
max_replication_lag                  = 5s

[DC-principal-port]
type=listener
service=DC-principal-RWS
protocol=MariaDBClient
port=4000


